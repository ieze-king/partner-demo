# From the HomeHunt (demo) organisation in the Getpropool Partner Portal (admin.getpropool.com/partner)
GETPROPOOL_API_KEY=
# Shown once when you add the webhook in the Partner Portal
GETPROPOOL_WEBHOOK_SECRET=
# Optional; defaults to the live API
GETPROPOOL_API_URL=https://api.getpropool.com/api/partner/v1
# Added automatically when you connect Upstash Redis in Vercel (Storage). Without them the demo keeps
# its copy in memory, which is fine locally but not on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
